{"id": "ps-03", "kind": "unknown_argument", "tool": "run_query", "args": {"name": "late_shipments", "params": {"start_date": "1994-01-01", "end_date": "1995-01-01", "name": "top_customers"}}, "expect": "reject", "note": "[A1] name inside params"}
{"id": "ex-01", "kind": "exhaustion", "tool": "run_sql", "args": {"sql": "SELECT count(*) FROM range(100000000000)"}, "expect": "reject", "note": "[A2] one-row answer after minutes of work; stopped by the query time limit"}
{"id": "ex-02", "kind": "exhaustion", "tool": "run_sql", "args": {"sql": "SELECT sum(a.range * b.range) FROM range(1000000) a, range(1000000) b"}, "expect": "reject", "note": "[A2] cross join of two million-row ranges"}
{"id": "ex-03", "kind": "exhaustion", "tool": "run_sql", "args": {"sql": "WITH RECURSIVE r(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r) SELECT count(*) FROM r"}, "expect": "reject", "note": "[A2] recursive CTE with no terminating condition"}
{"id": "ex-04", "kind": "exhaustion", "tool": "run_sql", "args": {"sql": "SELECT list(range(200000000)) AS l"}, "expect": "reject", "note": "[A2] one row holding a two-hundred-million element list"}
{"id": "ex-05", "kind": "exhaustion", "tool": "run_sql", "args": {"sql": "SELECT repeat('x', 2000) AS s FROM range(100000)", "limit": 100000}, "expect": "ok", "note": "[A2] within the row cap but about 200 MB of text: must come back truncated by size, not over size"}
{"id": "ex-06", "kind": "disclosure", "tool": "run_sql", "args": {"sql": "SELECT * FROM duckdb_databases()"}, "expect": "ok", "note": "[A2] discloses the warehouse file path; a documented limitation, not a gate"}
{"id": "ex-07", "kind": "type_abuse", "tool": "run_sql", "args": {"sql": "SELECT '\ud800' AS s"}, "expect": "reject", "note": "[A2] a lone UTF-16 surrogate, written as the JSON escape \\ud800 in this file"}
{"id": "ex-08", "kind": "type_abuse", "tool": "run_query", "args": {"name": "late_shipments", "params": {"start_date": "1995-01-01", "end_date": "1995-01-01"}}, "expect": "reject", "stricter_by_design": "an empty date window is rejected; the bare service returns an empty result", "note": "[A2] start_date equals end_date"}
{"id": "ex-09", "kind": "stacked", "tool": "run_sql", "args": {"sql": "SELECT 1; -- trailing comment"}, "expect": "reject", "note": "[A2] fails closed: the upstream limit wrapper only strips a final semicolon"}
